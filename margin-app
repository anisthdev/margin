#!/bin/sh
# Opens margin, starting it first when it isn't running:
#   margin-app            the window, or closes it
#   margin-app new        the window, on a new note
#   margin-app menu       the menu, or closes it
#   margin-app menu new   the menu, on a new note
# margin is the Quickshell config named margin: the package's in
# /etc/xdg/quickshell, or a ~/.config/quickshell/margin of your own.

case "$1 $2" in
"new ") action=compose ;;
"menu ") action=menu ;;
"menu new") action=capture ;;
" ") action=toggle ;;
*) action=$1 ;;
esac

call() {
    qs -c margin ipc call margin "$@" >/dev/null 2>&1
}

call "$action" && exit

setsid -f uwsm app -- qs -n -c margin >/dev/null 2>&1
# Once it answers, what was asked
for _ in $(seq 50); do
    sleep 0.1
    call "$action" && exit
done
exit 1
